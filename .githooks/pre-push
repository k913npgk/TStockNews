#!/usr/bin/env sh
set -eu
while read local_ref local_sha remote_ref remote_sha; do
  case "$remote_ref" in
    refs/heads/main|refs/heads/screener-data|refs/heads/screener-tests)
      echo 'Blocked: main uses PRs; state branches are managed separately by Actions.' >&2
      exit 1 ;;
    refs/heads/codex/*) ;;
    *) echo 'Blocked: project code pushes must use a codex/ branch.' >&2; exit 1 ;;
  esac
  if [ "$local_sha" = 0000000000000000000000000000000000000000 ]; then
    echo 'Blocked: branch deletion requires separate review.' >&2; exit 1
  fi
  if [ "$remote_sha" != 0000000000000000000000000000000000000000 ]; then
    git merge-base --is-ancestor "$remote_sha" "$local_sha" || { echo 'Blocked: non-fast-forward push.' >&2; exit 1; }
  fi
  if git ls-tree -r --name-only "$local_sha" | grep -E '(^|/)(\.env($|\.)|line-group-id\.txt$)|^(data|reports|test-runs)/|\.log$' >/dev/null; then
    echo 'Blocked: credentials, runtime data or logs in code branch.' >&2; exit 1
  fi
done
python -B -m unittest discover -s tests -v
node --test cloudflare/worker.test.mjs
