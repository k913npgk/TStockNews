{
  "name": "tstocknews-scheduler",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test worker.test.mjs",
    "test:runtime": "node --test tests/runtime.test.mjs",
    "deploy": "wrangler deploy",
    "deploy:disabled": "wrangler deploy --var DISPATCH_ENABLED:false",
    "deploy:check": "wrangler deploy --dry-run",
    "login": "wrangler login --device",
    "secret:github": "wrangler secret put GITHUB_TOKEN"
  },
  "devDependencies": {
    "wrangler": "4.147.0"
  }
}
